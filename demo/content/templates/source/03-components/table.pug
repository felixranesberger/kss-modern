include ../../mixins/_icon

- const rows = [['Ada Lovelace', 'ada@acme.io', 150, 'Owner', 'brand', 'Active', '€1,240.00'], ['Grace Hopper', 'grace@acme.io', 30, 'Admin', 'brand', 'Active', '€860.50'], ['Kai Jensen', 'kai@acme.io', 260, 'Editor', 'warning', 'Invited', '€0.00'], ['Mira Rossi', 'mira@acme.io', 200, 'Viewer', 'danger', 'Suspended', '€312.75']]

.table-card
  .table-card__header
    h2.table-card__title Members
    .stack
      .field__control.table-card__search
        +icon('search')
        input.input(type="search" placeholder="Search members" aria-label="Search members")
      button.btn.btn--sm(type="button")
        +icon('plus')
        | Invite
  table.table(class=modifierClass)
    thead
      tr
        th(scope="col") Name
        th(scope="col") Role
        th(scope="col") Status
        th.table__num(scope="col") Spend
    tbody
      each r in rows
        tr
          td
            .table__person
              span.avatar.avatar--sm(style=`--avatar-hue: ${r[2]}`)= r[0].split(' ').map(n => n[0]).join('')
              div
                strong= r[0]
                span= r[1]
          td= r[3]
          td
            span.badge.badge--dot(class=`badge--${r[4]}`)= r[5]
          td.table__num= r[6]
