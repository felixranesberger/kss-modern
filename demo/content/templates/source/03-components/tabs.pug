- const tabs = [['Overview', null, 'Everything at a glance', 'Revenue is up 12% this month, driven by the new Growth plan. Two projects need attention before Friday.'], ['Activity', '24', 'Recent activity', 'Ada closed three issues, Grace shipped the billing preview and Kai invited two new members.'], ['Settings', null, 'Workspace settings', 'Manage members, billing and integrations for the Acme workspace.']]

.tabs(class=modifierClass)
  .tabs__list(role="tablist" aria-label="Workspace")
    each t, i in tabs
      button.tabs__tab(role="tab" type="button" id=useId(`tab-${i}`) aria-controls=useId(`panel-${i}`) aria-selected=i === 0 ? 'true' : 'false' tabindex=i === 0 ? false : '-1')
        = t[0]
        if t[1]
          span.badge.badge--brand= t[1]
  each t, i in tabs
    .tabs__panel(role="tabpanel" id=useId(`panel-${i}`) aria-labelledby=useId(`tab-${i}`) hidden=i !== 0)
      h4= t[2]
      p= t[3]
