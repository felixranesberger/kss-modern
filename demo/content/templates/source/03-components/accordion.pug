include ../../mixins/_icon

- const faq = [['Can I change my plan later?', 'Yes. Upgrades apply immediately and downgrades take effect at the end of the billing cycle.'], ['Do you offer a free trial?', 'Every workspace starts with 14 days of Growth. No credit card needed.'], ['Where is my data stored?', 'In the EU, on servers in Frankfurt and Amsterdam, encrypted at rest and in transit.'], ['How do I cancel?', 'Open Settings, then Billing, then Cancel subscription. Your data stays exportable for 30 days.']]

.accordion(data-accordion)
  each item, i in faq
    details.accordion__item(open=i === 0)
      summary.accordion__summary
        = item[0]
        +icon('plus')
      .accordion__body
        p= item[1]
