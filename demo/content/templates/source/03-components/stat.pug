include ../../mixins/_icon

-
  const spark = (points) => {
    const max = Math.max(...points)
    const min = Math.min(...points)
    const step = 200 / (points.length - 1)
    return points.map((p, i) => `${i === 0 ? 'M' : 'L'}${(i * step).toFixed(1)} ${(36 - ((p - min) / (max - min)) * 32).toFixed(1)}`).join(' ')
  }
  const stats = [
    { label: 'Monthly revenue', icon: 'chart', value: '€48.2k', trend: '+12.4%', points: [12, 14, 13, 17, 16, 19, 22, 21, 25, 27, 26, 31] },
    { label: 'Active users', icon: 'user', value: '8,391', trend: '+4.1%', points: [30, 32, 31, 34, 33, 35, 36, 38, 37, 39, 41, 42] },
    { label: 'Churn', icon: 'trending-up', value: '1.8%', trend: '+0.3%', down: true, points: [10, 11, 10, 12, 13, 12, 14, 15, 14, 16, 17, 18] },
    { label: 'CO₂ saved', icon: 'leaf', value: '12.6 t', trend: '+18%', points: [4, 6, 7, 7, 9, 11, 12, 14, 15, 18, 20, 23] },
  ]

.stat-grid
  each s in stats
    .stat
      span.stat__label
        +icon(s.icon)
        = s.label
      span.stat__value= s.value
      span.stat__trend(class=s.down ? 'stat__trend--down' : '')
        = s.trend
        span  vs last month
      svg.stat__spark(class=s.down ? 'stat__spark--down' : '' viewBox="0 0 200 40" preserveAspectRatio="none" aria-hidden="true")
        path(d=`${spark(s.points)} L200 40 L0 40 Z` fill="currentColor" opacity="0.12")
        path(d=spark(s.points) fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" vector-effect="non-scaling-stroke")
