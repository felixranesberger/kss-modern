include _button
include _tag

//- internal helper, no schema: its public calls show up under the card
mixin cardActions(label)
  .card__actions
    +button({ label: label })
    +button({ label: 'Cancel', variant: 'ghost' })

mixin card(props)
  - var mixinName = 'organisms/Card'
  -
    var mixinSchema = z.object({
      title: z.string().meta({ examples: ['Card title'] }),
      links: z.array(z.strictObject({
        text: z.string().min(1),
        href: z.string(),
        isExternal: z.boolean().default(false),
      })).optional(),
      cta: z.strictObject({
        text: z.string().min(1),
        href: z.string().meta({ examples: ['/more'] }),
        variant: z.enum(['primary', 'ghost']).default('primary'),
      }).describe('Call to action below the links').optional(),
    })
  - const p = mixinSchema.parse(props)
  article.card
    h3= p.title
    +tag({ text: 'New' })
    +cardActions('Save')
    if p.links
      ul.card__links
        each link in p.links
          li: a(href=link.href target=link.isExternal ? '_blank' : undefined)= link.text
    if p.cta
      a.card__cta(href=p.cta.href class=`card__cta--${p.cta.variant}`)= p.cta.text
